# Drizzle
# This project's own database (acore_manager) — the one Drizzle owns and migrates.
# Note the port: the placeholder must be a syntactically valid URL, otherwise
# the build fails while parsing it.
DATABASE_URL="mysql://user:password@localhost:3306/acore_manager"

ORIGIN="http://localhost:5173"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Discord OAuth — https://discord.com/developers/applications
# Register this redirect URI on the Discord application:
#   <ORIGIN>/api/auth/callback/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# AzerothCore databases — owned and migrated by AzerothCore, never by Drizzle.
# One server/credential is enough: the database name is selected per client in
# src/lib/server/db/acore.ts (acore_auth, acore_world, acore_characters, …).
#
# This app reads a lot and writes almost nothing, so the grants are narrow. Read
# access is all it needs, except for one column:
#
#   acore_auth       SELECT on `account` (a password check when linking, and
#                    ownership), SELECT on `account_access` (the GM level behind
#                    the staff gate), UPDATE on `account`.`email` (the single
#                    write this project makes into AzerothCore's data).
#   acore_world      SELECT on `item_template` and the `*_dbc` tables
#                    (chrclasses, chrraces, areatable, skillline, itemdisplayinfo)
#                    for the names and icons the character pages show, and SELECT
#                    on `command` — the realm's own GM command catalogue, which the
#                    staff console reads rather than keeping a list of its own.
#   acore_characters SELECT on `characters`, `character_inventory`, `item_instance`,
#                    `character_skills`, `guild`, `guild_member`, `guild_rank`.
#
# No DDL anywhere. Accounts are created by the worldserver itself, not written by
# this app.
ACORE_DATABASE_URL="mysql://user:password@localhost:3306"

# AzerothCore worldserver SOAP (remote access).
#
# Requires SOAP.Enabled = 1 in worldserver.conf — it is disabled by default, and
# binds to 127.0.0.1:7878.
#
# The account must be an administrator: SOAP rejects anything below
# SEC_ADMINISTRATOR (gmlevel 3) with 403. Create and promote it once:
#   .account create soapweb <password>
#   .account set gmlevel soapweb 3 -1
#
# SOAP is arbitrary console-command execution over plain HTTP with basic auth, so
# keep the port on loopback (or the container network) and never expose it
# publicly. Call it only from server-side code.
ACORE_SOAP_URL="http://127.0.0.1:7878"
ACORE_SOAP_USER=""
ACORE_SOAP_PASSWORD=""

# Item icons, optional.
#
# `itemdisplayinfo_dbc` gives an icon's *name*, and the matching texture is one of
# the files extracted from the client's MPQ archives into static/interface/Icons.
# By default they are served from this site, so a player's browser fetches item
# icons from here and nowhere else.
#
# Set this only when those files are not next to the app: both .gitignore and
# .dockerignore exclude static/interface, because the artwork is Blizzard's and
# this repository is not a distribution channel for it — so a container image has
# no icons unless you mount or copy them in. Whatever this points at, a player's
# browser fetches item icons from that host.
#
# It must be a root-relative path (leading slash) or an absolute http(s) URL.
# Anything else is ignored with a warning rather than honoured, because a value
# the browser cannot fetch fails invisibly: every icon becomes a placeholder.
# A value that looks like a path on disk — including a Vite /@fs/ URL — is the
# usual mistake here.
#
# The value is read when the server starts, so restart the dev server after
# changing it.
# ICON_BASE_URL="/interface/Icons"
